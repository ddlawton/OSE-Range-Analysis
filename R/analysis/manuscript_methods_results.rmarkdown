## Millet Yield Analysis Tables

### Model Summary






```{r tbl-yield-model}
#| label: tbl-yield-model
#| tbl-cap: "Model summary for millet yield by fertilizer treatment and region. Generalized linear mixed model (GLMM) with Tweedie family distribution. Fixed effects include fertilizer treatment, region, and their interaction. Random effects account for farmer-level variation."
#| echo: false
#| message: false
#| warning: false


yield_mod <- yield_mod_early

# Prepare tidy output with human-readable labels
tidy_prepped <- broom.mixed::tidy(yield_mod) %>%
  mutate(
    term = term %>%
      str_replace_all("^\\(Intercept\\)$", "Intercept") %>%
      str_replace_all("fertilizer_treatmentfertilized", "Fertilized") %>%
      str_replace_all("regionKaffrine", "Kaffrine") %>%
      str_replace_all("regionThies", "Thies"),
    p_value = p.value,
    p_label = case_when(
      is.na(p_value) ~ NA_character_,
      p_value < 0.001 ~ "<0.001",
      TRUE ~ formatC(p_value, digits = 3, format = "f")
    ),
    sig = case_when(
      is.na(p_value) ~ "",
      p_value < 0.001 ~ "***",
      p_value < 0.01  ~ "**",
      p_value < 0.05  ~ "*",
      TRUE ~ ""
    ),
    p_label = if_else(is.na(p_label), NA_character_, paste0(p_label, sig))
  ) %>%
  select(effect, component, term, estimate, std.error, statistic, p_value, p_label)

# Build the gt table
tbl_yield_model <- tidy_prepped %>%
  gt(rowname_col = "term") %>%
  tab_row_group(
    group = "Fixed effects",
    rows = tidy_prepped$effect == "fixed"
  ) %>%
  tab_row_group(
    group = "Random parameters",
    rows = tidy_prepped$effect == "ran_pars"
  ) %>%
  cols_label(
    term = "Term",
    estimate = "Estimate",
    std.error = "Std. error",
    statistic = "z",
    p_label = "p-value",
    component = "Component"
  ) %>%
  fmt_number(
    columns = vars(estimate, std.error, statistic, p_value),
    decimals = 3
  ) %>%
  fmt_missing(
    columns = everything(),
    missing_text = "-"
  ) %>%
  cols_move_to_end(columns = vars(p_label)) %>%
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_row_groups()
  ) %>%
  tab_header(
    title = "Model Estimates for Yield ~ Fertilizer × Region",
    subtitle = "Fixed effects and random parameter SDs"
  ) %>%
  cols_align(
    align = "center",
    columns = vars(estimate, std.error, statistic, p_label)
  )

# Save as PNG
save_gt_png(tbl_yield_model, "millet_yield_model_summary.png")

# Display table
tbl_yield_model
```






### Pairwise Comparisons






```{r tbl-yield-pairwise}
#| label: tbl-yield-pairwise
#| tbl-cap: "Pairwise comparisons of estimated marginal means for millet yield across treatment × region combinations. Ratios indicate the multiplicative difference between groups. Tukey adjustment applied for multiple comparisons."
#| echo: false
#| message: false
#| warning: false

# Define emmeans function (same as in original analysis)
get_emmeans_and_pairs <- function(glmm_mod) {
  emmeans_obj <- emmeans(glmm_mod, ~ fertilizer_treatment * region, type = "response")
  
  emmeans_tbl <- as_tibble(emmeans_obj) 
  
  pairs_tbl <- as_tibble(pairs(emmeans_obj, adjust = "tukey"))
  
  list(
    emmeans = emmeans_tbl,
    pairwise = pairs_tbl
  )
}

# Get emmeans
emms <- get_emmeans_and_pairs(yield_mod)

# Prepare and format p-value with significance stars
emms_pw_prepped <- emms$pairwise %>%
  mutate(
    p_label = case_when(
      is.na(p.value)   ~ "-",
      p.value == 0     ~ "<0.001***",
      p.value < 0.001  ~ "<0.001***",
      p.value < 0.01   ~ paste0(formatC(p.value, digits = 3, format = "e"), "**"),
      p.value < 0.05   ~ paste0(formatC(p.value, digits = 3, format = "e"), "*"),
      TRUE             ~ formatC(p.value, digits = 3, format = "e")
    )
  )

# Make column names readable
col_labels <- c(
  contrast   = "Contrast",
  ratio      = "Ratio",
  SE         = "Std. Error",
  df         = "DF",
  null       = "Null",
  z.ratio    = "z Ratio",
  p_label    = "p-value"
)

# Create gt table
tbl_yield_pairwise <- emms_pw_prepped %>%
  select(contrast, ratio, SE, df, null, z.ratio, p_label) %>%
  gt(rowname_col = "contrast") %>%
  cols_label(!!!col_labels) %>%
  fmt_number(
    columns = c("ratio", "SE", "z.ratio"),
    decimals = 3
  ) %>%
  fmt_missing(columns = everything(), missing_text = "-") %>%
  tab_header(
    title = "Estimated Marginal Means Pairwise Contrasts",
    subtitle = "Table of pairwise ratios, z statistics, and p-values"
  ) %>%
  cols_align(
    align = "center",
    columns = c("ratio", "SE", "z.ratio", "null", "df", "p_label")
  ) %>%
  opt_row_striping()

# Save as PNG
save_gt_png(tbl_yield_pairwise, "millet_yield_pairwise_comparisons.png")

# Display table
tbl_yield_pairwise
```






## Ground Cover Mediation Analysis Tables






```{r tbl-ground-cover-unified}
#| label: tbl-ground-cover-unified
#| tbl-cap: "Model summary for the unified ground cover mediation analysis. Generalized additive model (GAM) with Tweedie family distribution examining how ground cover mediates the effect of fertilizer treatment on grasshopper density. The model includes parametric terms for fertilizer treatment, mission number, and region, plus smooth terms for ground cover (varying by fertilizer treatment) and farmer random effects."
#| echo: false
#| message: false
#| warning: false

# Prepare data for ground cover model (matching the original analysis)
data_gc <- data |>
  mutate(
    farmer = factor(farmer),
    mission_number = factor(mission_number),
    fertilizer_treatment = factor(fertilizer_treatment),
    region = factor(region)
  )

# Fit ground cover mediation model with caching (same as original)
gc_mod <- cache_model(
  model_name = "ground_cover_mediation",
  data = data_gc,
  fit_function = function(data) {
    gam(
      ose_count ~ 
        fertilizer_treatment * mission_number + 
        region + 
        s(percent_ground_cover, by=fertilizer_treatment) + 
        s(farmer, bs='re'),
      data = data,
      family = tw(),
      select = TRUE
    )
  }
)

# Extract parametric and smooth terms
tidy_mod <- broom::tidy(gc_mod, parametric = TRUE) %>%
  mutate(term_type = "Parametric")

smooth_mod <- broom::tidy(gc_mod, parametric = FALSE) %>%
  mutate(term_type = "Smooth")

# Combine into one table
combined_mod <- bind_rows(tidy_mod, smooth_mod)

# Create a unified gt table
tbl_ground_cover <- combined_mod %>%
  gt(groupname_col = "term_type") %>%
  fmt_number(
    columns = c(estimate, std.error, statistic, p.value),
    decimals = 3
  ) %>%
  fmt_missing(
    columns = everything(),
    missing_text = "-"
  ) %>%
  cols_label(
    term = "Term",
    estimate = "Estimate",
    std.error = "Std. Error",
    statistic = "Statistic",
    p.value = "P-value",
    edf = "EDF",
    ref.df = "Ref. DF"
  ) %>%
  tab_header(
    title = "Ground Cover × Fertilizer Mediation Model",
    subtitle = "Parametric and smooth terms from GAM"
  ) %>%
  tab_source_note(
    source_note = md(paste0("Model deviance explained: ", round(summary(gc_mod)$dev.expl * 100, 1), "%"))
  ) %>%
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_row_groups()
  )

# Save as PNG
save_gt_png(tbl_ground_cover, "ground_cover_fertilizer_mediation_model.png")

# Display table
tbl_ground_cover
```






## Temperature Analysis Table






```{r}
#| label: tbl-temperature-model
#| tbl-cap: "Model summary for temperature effects on grasshopper density. Generalized additive model (GAM) with Tweedie family distribution examining whether temperature influences grasshopper density while accounting for region, mission, and farmer as random effects.  Temperature was not significant, indicating that temperature does not meaningfully explain grasshopper density once region and mission timing are accounted for."
#| echo: false
#| message: false
#| warning: false

# Load the cached temperature model
temp_mod <- cache_model(
  model_name = "locust_temperature_gam",
  data = data |>
    filter(fertilizer_treatment == 'control') |>
    select(year, region, farmer, mission_number, ose_count, temperature) |>
    mutate(
      region = factor(region),
      farmer = factor(farmer),
      mission_number = factor(mission_number)
    ) |>
    drop_na(temperature, mission_number, region, ose_count),
  fit_function = function(data) {
    mgcv::gam(
      ose_count ~
        s(temperature, k = 10) +
        s(region, bs='re') +
        s(farmer, bs = 're') +
        s(mission_number, bs = 're'),
      data = data,
      family = mgcv::tw(),
      select = TRUE
    )
  }
)

# Extract smooth terms
temp_summary <- broom::tidy(temp_mod, parametric = FALSE) %>%
  mutate(term = case_when(
    term == "s(temperature)" ~ "Temperature (smooth)",
    term == "s(region)" ~ "Region (random effect)",
    term == "s(farmer)" ~ "Farmer (random effect)",
    term == "s(mission_number)" ~ "Mission (random effect)",
    TRUE ~ term
  ))

# Create gt table with consistent style
tbl_temperature <- temp_summary %>%
  gt(rowname_col = "term") %>%
  cols_label(
    term = "Term",
    edf = "EDF",
    ref.df = "Ref. DF",
    statistic = "F-statistic",
    p.value = "P-value"
  ) %>%
  fmt_number(
    columns = c(edf, ref.df, statistic, p.value),
    decimals = 3
  ) %>%
  fmt_missing(
    columns = everything(),
    missing_text = "-"
  ) %>%
  tab_header(
    title = "Temperature Effects on Grasshopper Density",
    subtitle = "Smooth terms from GAM"
  ) %>%
  tab_source_note(
    source_note = md(paste0(
      "Model deviance explained: ", 
      round(summary(temp_mod)$dev.expl * 100, 1), 
      "%. Analysis restricted to control plots only."
    ))
  ) %>%
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_column_labels()
  )

# Save as PNG
save_gt_png(tbl_temperature, "temperature_effects_grasshopper_density.png")

# Display table
tbl_temperature 
```






## Model Summary Table






```{r tbl-model-summary}
#| label: tbl-model-summary
#| tbl-cap: "Summary of all statistical models used in the analysis. For each model, the table shows the response variable, statistical family, random effects structure, and sample size (number of observations)."
#| echo: false
#| message: false
#| warning: false

# Create a comprehensive model summary table
model_summary_data <- tibble::tribble(
  ~Model, ~Response, ~Family, ~Random_Effects, ~Sample_Size,
  
  # Density models (3 missions)
  "Density Mission 1", "Grasshopper count", "Poisson", "Farmer (1|farmer)", nrow(model_data[[1]]),
  "Density Mission 2", "Grasshopper count", "Poisson", "Farmer (1|farmer)", nrow(model_data[[2]]),
  "Density Mission 3", "Grasshopper count", "Poisson", "Farmer (1|farmer)", nrow(model_data[[3]]),
  
  # Damage models (3 missions)
  "Damage Mission 1", "Damage percent", "Tweedie", "Farmer (1|farmer)", nrow(model_data_damage[[1]]),
  "Damage Mission 2", "Damage percent", "Tweedie", "Farmer (1|farmer)", nrow(model_data_damage[[2]]),
  "Damage Mission 3", "Damage percent", "Tweedie", "Farmer (1|farmer)", nrow(model_data_damage[[3]]),
  
  # Yield model
  "Millet Yield", "Yield (kg/ha)", "Tweedie", "Farmer (1|farmer)", nrow(data_yield_early),
  
  # Ground cover mediation GAM
  "Ground Cover Mediation", "Grasshopper count", "Tweedie", "Farmer s(farmer, bs='re')", nrow(data_gc_early),
  
  # Ground cover by fertilizer GLMM
  "Ground Cover × Fertilizer", "Ground cover percent", "Gaussian", "Farmer (1|farmer)", 
    nrow(data |> 
      select(region, farmer, fertilizer_treatment, mission_number, percent_ground_cover) |> 
      drop_na()),
  
  # Temperature GAM
  "Temperature Effects", "Grasshopper count", "Tweedie", 
    "Region s(region, bs='re'); Farmer s(farmer, bs='re'); Mission s(mission_number, bs='re')",
    nrow(data |>
      filter(fertilizer_treatment == 'control') |>
      select(year, region, farmer, mission_number, ose_count, temperature) |>
      drop_na(temperature, mission_number, region, ose_count))
)

# Create the gt table with consistent formatting
tbl_model_summary <- model_summary_data |>
  gt() |>
  cols_label(
    Model = "Model",
    Response = "Response Variable",
    Family = "Statistical Family",
    Random_Effects = "Random Effects",
    Sample_Size = "Sample Size (n)"
  ) |>
  fmt_number(
    columns = Sample_Size,
    decimals = 0
  ) |>
  tab_header(
    title = "Summary of All Statistical Models"
  ) |>
  tab_source_note(
    source_note = md("**Note:** All models include fixed effects for fertilizer treatment and region (and their interaction where applicable). Density models used separate analyses for each mission. GAM models used smooth terms s() with re (random effect) basis for random effects; GLMM models used standard random intercept notation (1|farmer).")
  ) |>
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_column_labels()
  ) |>
  cols_align(
    align = "center",
    columns = c(Family, Sample_Size)
  ) |>
  cols_align(
    align = "left",
    columns = c(Model, Response, Random_Effects)
  ) |>
  tab_style(
    style = cell_borders(
      sides = "top",
      weight = px(2),
      color = "black"
    ),
    locations = cells_body(
      rows = c(4, 7, 8, 9, 10)
    )
  )

# Save as PNG
save_gt_png(tbl_model_summary, "model_summary_all_models.png")

# Display table
tbl_model_summary
```

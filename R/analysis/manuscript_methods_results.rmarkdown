## Raw grasshopper count by treatment, mission, and region






```{r fig-supp-raw-count-treatment-mission-region}
#| label: fig-supp-raw-count-treatment-mission-region
#| fig-cap: "Raw Senegalese grasshopper density by fertilizer treatment and mission across regions. Individual farmer observations (points) are connected by lines to show within-farm changes across missions. Density patterns varied substantially by region and mission, with no consistent fertilizer treatment effect."
#| echo: false
#| message: false
#| warning: false
#| fig-width: 6
#| fig-height: 12

# Get unique fertilizer treatments and farmers (if needed)
fertilizer_levels <- levels(data$fertilizer_treatment)
farmers <- unique(data$farmer)

# Expand grid for all combinations you want (here: both treatments, all farmers)
# This is just to 
null_rows <- expand_grid(
  region = "Saint Louis",
  fertilizer_treatment = fertilizer_levels,
  mission_number = factor("3", levels = levels(data$mission_number)),
  ose_count = NA_real_,
  farmer = farmers
)

village_count_data <- data |>
  select(region,fertilizer_treatment,mission_number,ose_count,farmer) 

village_count_data <- bind_rows(village_count_data, null_rows)



# Helper function to plot by mission with optional legend
plot_mission_counts <- function(data, mission, show_legend = TRUE) {
  dat <- data |> filter(mission_number == mission)
  line_dat <- dat |> drop_na(ose_count)
  p <- ggplot(dat, aes(x = fertilizer_treatment, y = ose_count, color = region)) +
    geom_point(size = 2) +
    geom_line(data = line_dat, aes(group = farmer)) +
    MetBrewer::scale_color_met_d(name = "Degas", drop = FALSE) +
    labs(
      title = paste0("mission ", mission),
      x = "",
      y = bquote('individuals'~bold('•')~100~m^-2),
      color = "",
      color = ""
    ) +
    ylim(0,150) +
    theme_pubr() +
    theme(plot.title = element_text(hjust = 0.5), legend.position = "bottom")
  if (!show_legend) {
    p <- p + theme(legend.position = "none")
  }
  return(p)
}


m2_raw_plot <- plot_mission_counts(village_count_data, mission = 2, show_legend = FALSE)
m3_raw_plot <- plot_mission_counts(village_count_data, mission = 3, show_legend = TRUE)

(m2_raw_plot / m3_raw_plot)
```






## Ground Cover by Fertilizer Treatment 






```{r fig-supp-ground-cover-prep, echo=FALSE}
#| message: false
#| warning: false
# Prepare model and tidy table (used for caption and later table rendering)
data_gc_test <- data |>
  select(region, farmer, fertilizer_treatment, mission_number, percent_ground_cover) |>
  drop_na() |>
  mutate(
    farmer = factor(farmer),
    mission_number = factor(mission_number),
    fertilizer_treatment = factor(fertilizer_treatment),
    region = factor(region)
  )

gc_lmm <- glmmTMB::glmmTMB(
  percent_ground_cover ~ fertilizer_treatment * mission_number + region + (1|farmer),
  data = data_gc_test,
  family = gaussian()
)

# Tidy output (this is the table source)
tidy_prepped <- broom.mixed::tidy(gc_lmm) %>%
  mutate(
    term = term %>%
      str_replace_all("^\\(Intercept\\)$", "Intercept") %>%
      str_replace_all("fertilizer_treatmentfertilized", "Fertilized") %>%
      str_replace_all("mission_number2", "Mission 2") %>%
      str_replace_all("mission_number3", "Mission 3") %>%
      str_replace_all("regionKaffrine", "Kaffrine") %>%
      str_replace_all("regionSaint Louis", "Saint Louis") %>%
      str_replace_all("regionThies", "Thies") %>%
      str_replace_all("fertilizer_treatmentfertilized:mission_number2", "Fertilized × Mission 2") %>%
      str_replace_all("fertilizer_treatmentfertilized:mission_number3", "Fertilized × Mission 3"),
    p_value = p.value
  )

# Extract p-values for caption from the tidy table
gc_fert_p <- tidy_prepped %>% filter(term == "Fertilized") %>% pull(p_value)

# Joint test for the fertilizer:mission interaction using LRT
gc_lmm_no_inter <- update(gc_lmm, . ~ . - fertilizer_treatment:mission_number)
gc_int_lrt <- anova(gc_lmm_no_inter, gc_lmm)
gc_int_p <- NA_real_
if ("Pr(>Chisq)" %in% colnames(gc_int_lrt)) {
  gc_int_p <- gc_int_lrt$`Pr(>Chisq)`[2]
} else if ("p.value" %in% colnames(gc_int_lrt)) {
  gc_int_p <- gc_int_lrt$p.value[2]
}

gc_caption <- paste0(
  "Ground cover by fertilizer treatment and mission across regions. Ground cover increased throughout the growing season across all regions, with minimal differences between control and fertilized treatments. Statistical analysis (",
  "@tbl-ground-cover-fertilizer-effects",
  ") confirmed no significant main effect of fertilizer (p ", format_p(gc_fert_p), ") or fertilizer × mission interaction (p ", format_p(gc_int_p), ")."
)

```

```{r fig-supp-ground-cover-treatment}
#| label: fig-supp-ground-cover-treatment
#| fig-cap: "Ground cover by fertilizer treatment and mission across regions. Ground cover increased throughout the growing season across all regions, with minimal differences between control and fertilized treatments. Statistical analysis (@tbl-ground-cover-fertilizer-effects) confirmed no significant main effect of fertilizer or fertilizer × mission interaction."
#| echo: false
#| message: false
#| warning: false
#| fig-width: 8
#| fig-height: 8

# Ensure mission_number is a factor with all levels
mission_levels <- c("1", "2", "3")
regions <- unique(data$region)
ground_cover_data <- data |>
  mutate(mission_number = factor(mission_number, levels = mission_levels))

# Create a named list of plots, one per region
region_plots <- lapply(regions, function(reg) {
  ground_cover_data |>
    filter(region == reg) |>
    ggplot(aes(
      x = mission_number, 
      y = percent_ground_cover, 
      color = fertilizer_treatment,
      fill = fertilizer_treatment
    )) +
    geom_boxplot(
      position = position_dodge(width = 0.8),
      outlier.shape = NA,
      alpha = 0.7
    ) +
    geom_jitter(
      position = position_jitterdodge(jitter.width = 0.4, jitter.height = 0),
      alpha = 0.5,
      size = 0.8
    ) +
    scale_x_discrete(drop = FALSE, limits = mission_levels) +  # <-- Ensures all ticks
    scale_color_manual(
      values = c('black', 'darkgreen'),
      labels = c('Control', 'Fertilized')
    ) +
    scale_fill_manual(
      values = c('#cccccc', '#a6dba0'),
      labels = c('Control', 'Fertilized')
    ) +
    labs(
      title = paste(reg),
      x = "mission number",
      y = "ground cover (%)",
      fill = "treatment",
      color = "treatment"
    ) +
    theme_pubr()
})
names(region_plots) <- regions

# Combine plots with patchwork 
wrap_plots(region_plots, ncol = 2) + 
  plot_layout(guides = "collect", axis_titles = "collect") & 
  theme(legend.position = "bottom")
```






